{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finecraft.invalid/schemas/prototype.schema.json",
  "title": "FineCraft hybrid block geometry metadata",
  "type": "object",
  "required": [
    "schema_version", "format", "minecraft_version", "source_commit", "coordinate_system",
    "block_id", "prototype_id", "geometry_type", "collision_type", "source_models", "states", "geometry"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "format": { "const": "finecraft-hybrid-geometry" },
    "minecraft_version": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "block_id": { "type": "string", "pattern": "^minecraft:[a-z0-9_]+$" },
    "prototype_id": { "type": "integer", "minimum": 0 },
    "geometry_type": { "type": "string", "minLength": 1 },
    "collision_type": { "type": "string", "minLength": 1 },
    "source_models": { "type": "array", "items": { "type": "string" } },
    "coordinate_system": {
      "type": "object",
      "required": ["space", "axis_order", "units_per_block", "prototype_origin", "blender_to_minecraft", "layout_offsets_removed", "coordinate_tolerance"],
      "properties": {
        "space": { "const": "prototype_local_minecraft" },
        "axis_order": { "const": ["x_east", "y_up", "z_south"] },
        "units_per_block": { "const": 1.0 },
        "prototype_origin": { "const": "bottom_centre_of_lower_or_foot_cell" },
        "blender_to_minecraft": { "const": "(x, z, -y)" },
        "layout_offsets_removed": { "const": true },
        "coordinate_tolerance": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state_id", "state_properties", "geometry_type", "collision_type", "source_models", "source_shape_id", "collision_boxes"],
        "properties": {
          "state_id": { "type": "integer", "minimum": 0 },
          "state_properties": { "type": "object" },
          "geometry_type": { "type": "string" },
          "collision_type": { "type": "string" },
          "source_models": { "type": "array", "items": { "type": "string" } },
          "source_shape_id": { "type": "integer", "minimum": 0 },
          "collision_boxes": {
            "type": "array",
            "items": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}], "minItems": 6, "maxItems": 6 }
          }
        },
        "additionalProperties": true
      }
    },
    "geometry": {
      "type": "object",
      "required": ["binary_file", "header", "vertex_layout", "index_layout", "components"],
      "properties": {
        "binary_file": { "type": "string" },
        "header": { "type": "object", "required": ["magic_ascii", "version", "header_bytes", "component_count"] },
        "vertex_layout": { "type": "object", "required": ["encoding", "stride_bytes", "attributes"] },
        "index_layout": { "type": "object", "required": ["encoding", "element_bytes"] },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "state_id", "source_models", "material", "vertex_count", "index_count", "triangle_count", "vertex_buffer", "index_buffer"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "state_id": { "type": "integer", "minimum": 0 },
              "source_models": { "type": "array", "items": { "type": "string" } },
              "material": { "type": ["object", "null"] },
              "vertex_count": { "type": "integer", "minimum": 1 },
              "index_count": { "type": "integer", "minimum": 3, "multipleOf": 3 },
              "triangle_count": { "type": "integer", "minimum": 1 },
              "vertex_buffer": { "type": "object", "required": ["byte_offset", "byte_length"] },
              "index_buffer": { "type": "object", "required": ["byte_offset", "byte_length"] }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
